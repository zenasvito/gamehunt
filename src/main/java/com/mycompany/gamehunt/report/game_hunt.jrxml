	<queryString language="SQL">
		<![CDATA[SELECT 'Penjualan' AS jenis,
       sold_at      AS waktu,
       product_name AS game,
       sold_by      AS pihak,
       qty,
       total
FROM sales
UNION ALL
SELECT 'Pembelian',
       bought_at,
       product_name,
       supplier_name,
       qty,
       total
FROM purchases
ORDER BY waktu DESC]]>
	</queryString>
